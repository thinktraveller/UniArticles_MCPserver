ELSEVIER_API_KEY=your_elsevier_api_key
# Optional. Only if your institution issued an Elsevier Institutional Token
# (broader Elsevier access). Leave empty otherwise.
ELSEVIER_INSTTOKEN=
# Optional. PubMed (NCBI Entrez) works without it; setting it only raises the
# rate limit from 3 to 10 requests/sec. Get a free key from your NCBI account.
NCBI_API_KEY=
# Optional. If unset, Semantic Scholar tools are NOT registered (its keyword search
# is unusable without a key). Get a free key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# Optional. CORE tools still work without it, but are heavily rate-limited
# (~5 requests, then a 10-minute lockout). Get a free key at https://core.ac.uk/services/api
CORE_API_KEY=
