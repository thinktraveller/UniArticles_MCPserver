ELSEVIER_API_KEY=your_elsevier_api_key
# Optional. PubMed (NCBI Entrez) works without it; setting it only raises the
# rate limit from 3 to 10 requests/sec. Free: sign in at https://www.ncbi.nlm.nih.gov/
# then create a key at https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=
# Optional. CORE tools still work without it, but are heavily rate-limited
# (~5 requests, then a 10-minute lockout). Free key: https://core.ac.uk/services/api#form
CORE_API_KEY=
